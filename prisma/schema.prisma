generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String?
  name           String?
  image          String?
  role           UserRole      @default(USER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  onboardingComplete Boolean       @default(false)
  businessType       BusinessType?
  mainMarket         Market?
  mainGoal           Goal?
  storeUrl           String?

  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]

  savedItems         SavedItem[]
  searches           Search[]
  reports            Report[]
  productValidations ProductValidation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum BusinessType {
  DROPSHIPPING
  SHOPIFY_BRAND
  DTC
  AGENCY
  OTHER
}

enum Market {
  FRANCE
  EUROPE
  USA
  UK
  WORLDWIDE
}

enum Goal {
  FIND_OPPORTUNITIES
  VALIDATE_PRODUCTS
  ANALYZE_COMPETITORS
  ANALYZE_ADS
  MONITOR_COMPETITORS
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// ORGANIZATION / BILLING / USAGE
// ============================================================

model Organization {
  id       String         @id @default(cuid())
  name     String
  isAgency Boolean        @default(false)
  parentId String?
  parent   Organization?  @relation("AgencyClients", fields: [parentId], references: [id])
  clients  Organization[] @relation("AgencyClients")

  users        User[]
  subscription Subscription?
  usage        Usage[]
  stores       Store[]
  competitors  Competitor[]
  alerts       Alert[]
  trackings    Tracking[]
  aiInsights   AIInsight[]
  reports      Report[]
  comparisons  CompetitorComparison[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Plan {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id])
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Usage {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  period             String // "YYYY-MM"
  storeAnalyses      Int          @default(0)
  productValidations Int          @default(0)
  aiAnalyses         Int          @default(0)
  competitorsTracked Int          @default(0)
  reportsGenerated   Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, period])
}

// ============================================================
// STORE / PRODUCT / COMPETITOR
// ============================================================

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  domain   String
  name     String
  platform String?
  country  String?
  category String?
  currency String  @default("EUR")

  status          AnalysisStatus @default(PENDING)
  firstObservedAt DateTime?
  lastObservedAt  DateTime?

  products         Product[]
  ads              Ad[]
  trafficEstimates TrafficEstimate[]
  revenueEstimates RevenueEstimate[]
  timelineEvents   TimelineEvent[]
  competitor       Competitor?
  savedItems       SavedItem[]

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  name           String
  url            String?
  price          Float?
  compareAtPrice Float?
  currency       String  @default("EUR")
  images         Json?
  description    String? @db.Text
  variants       Json?

  firstObservedAt DateTime?
  lastObservedAt  DateTime?

  ads            Ad[]
  timelineEvents TimelineEvent[]
  validations    ProductValidation[]
  savedItems     SavedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Competitor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  storeId        String?      @unique
  store          Store?       @relation(fields: [storeId], references: [id])

  name     String
  domain   String
  category String?
  tracked  Boolean @default(false)

  alerts         Alert[]
  tracking       Tracking?
  timelineEvents TimelineEvent[]
  savedItems     SavedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ADS
// ============================================================

enum AdPlatform {
  META
  TIKTOK
  GOOGLE
  OTHER
}

enum AdStatus {
  ACTIVE
  INACTIVE
}

enum AdAngle {
  PROBLEM_SOLUTION
  BEFORE_AFTER
  DEMONSTRATION
  UGC
  TESTIMONIAL
  LIFESTYLE
  CURIOSITY
  FOMO
  DISCOUNT
  SOCIAL_PROOF
  EDUCATIONAL
  EMOTIONAL
}

model Ad {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  platform       AdPlatform
  status         AdStatus   @default(ACTIVE)
  angle          AdAngle?
  offer          String?
  cta            String?
  landingPageUrl String?

  firstSeenAt DateTime
  lastSeenAt  DateTime

  source      String     @default("mock")
  confidence  Confidence @default(MEDIUM)
  observedAt  DateTime   @default(now())
  methodology String?    @db.Text

  creatives      AdCreative[]
  timelineEvents TimelineEvent[]
  savedItems     SavedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdFormat {
  VIDEO
  IMAGE
  CAROUSEL
  OTHER
}

model AdCreative {
  id   String @id @default(cuid())
  adId String
  ad   Ad     @relation(fields: [adId], references: [id])

  format       AdFormat
  mediaUrl     String?
  thumbnailUrl String?
  hook         String?
  headline     String?
  primaryText  String?  @db.Text

  firstSeenAt DateTime
  lastSeenAt  DateTime
  status      AdStatus @default(ACTIVE)

  analysis AdAnalysis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdAnalysis {
  id         String     @id @default(cuid())
  creativeId String     @unique
  creative   AdCreative @relation(fields: [creativeId], references: [id])

  summary             String   @db.Text
  hookAnalysis        String?  @db.Text
  visualAnalysis      String?  @db.Text
  offerAnalysis       String?  @db.Text
  ctaAnalysis         String?  @db.Text
  audienceHypothesis  String?  @db.Text
  angleClassification AdAngle?
  strengths           Json?
  weaknesses          Json?
  objections          Json?
  improvements        Json?
  testingIdeas        Json?

  confidence  Confidence @default(MEDIUM)
  model       String     @default("mock")
  generatedAt DateTime   @default(now())
}

// ============================================================
// ESTIMATES (confidence system)
// ============================================================

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum DataFreshness {
  FRESH
  RECENT
  STALE
  UNKNOWN
}

model TrafficEstimate {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  monthlyVisitsLow  Int
  monthlyVisitsHigh Int
  trend             Json // [{date, visits}]
  sources           Json // {organic, paid, social, direct, referral}
  countries         Json // [{country, share}]
  devices           Json // {desktop, mobile, tablet}

  confidence  Confidence    @default(MEDIUM)
  source      String        @default("mock")
  freshness   DataFreshness @default(RECENT)
  observedAt  DateTime      @default(now())
  methodology String        @db.Text

  createdAt DateTime @default(now())
}

model RevenueEstimate {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  dailyLow    Float
  dailyHigh   Float
  monthlyLow  Float
  monthlyHigh Float
  annualLow   Float
  annualHigh  Float

  aovLow             Float
  aovHigh            Float
  conversionLow      Float
  conversionHigh     Float
  adSpendMonthlyLow  Float?
  adSpendMonthlyHigh Float?

  confidence  Confidence @default(MEDIUM)
  source      String     @default("mock")
  observedAt  DateTime   @default(now())
  methodology String     @db.Text

  createdAt DateTime @default(now())
}

// ============================================================
// VALIDATION / COMPARISON
// ============================================================

model ProductValidation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  productName        String
  productUrl         String?
  competitorStoreUrl String?
  sellingPrice       Float
  productCost        Float?
  shippingCost       Float?
  targetMarket       Market?
  expectedConversion Float?

  result Json // full computed ValidationReport (signals, evidence, risks, ai assessment)

  createdAt DateTime @default(now())
}

model CompetitorComparison {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  myStoreUrl   String?
  competitorId String?

  result Json // computed comparison payload

  createdAt DateTime @default(now())
}

// ============================================================
// ALERTS / TRACKING / TIMELINE
// ============================================================

enum AlertType {
  NEW_AD
  NEW_PRODUCT
  PRICE_CHANGE
  CREATIVE_CHANGE
  STORE_CHANGE
  AD_STOPPED
  AD_STARTED
  TRAFFIC_CHANGE
  SIGNIFICANT_ACTIVITY_CHANGE
}

model Alert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  competitorId   String?
  competitor     Competitor?  @relation(fields: [competitorId], references: [id])

  type  AlertType
  title String
  body  String    @db.Text
  read  Boolean   @default(false)

  entityType String?
  entityId   String?

  createdAt DateTime @default(now())
}

model Tracking {
  id           String     @id @default(cuid())
  competitorId String     @unique
  competitor   Competitor @relation(fields: [competitorId], references: [id])

  trackNewAds       Boolean @default(true)
  trackNewProducts  Boolean @default(true)
  trackPriceChanges Boolean @default(true)
  trackLandingPages Boolean @default(true)
  trackStoreChanges Boolean @default(true)
  trackCreatives    Boolean @default(true)
  trackAdStatus     Boolean @default(true)
  enabled           Boolean @default(true)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
}

model TimelineEvent {
  id           String      @id @default(cuid())
  storeId      String?
  store        Store?      @relation(fields: [storeId], references: [id])
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id])
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id])
  adId         String?
  ad           Ad?         @relation(fields: [adId], references: [id])

  type        String
  title       String
  description String?  @db.Text
  occurredAt  DateTime
  metadata    Json?

  createdAt DateTime @default(now())
}

// ============================================================
// AI / REPORTS / SAVED / SEARCH
// ============================================================

model AIInsight {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  type       String // STRATEGY | STORE_AUDIT | COMPARISON | CHAT
  entityType String?
  entityId   String?

  content    Json
  confidence Confidence @default(MEDIUM)
  model      String     @default("mock")

  createdAt DateTime @default(now())
}

enum ReportType {
  STORE_ANALYSIS
  COMPETITOR_REPORT
  PRODUCT_VALIDATION
  AD_ANALYSIS
  MARKET_REPORT
}

model Report {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  type             ReportType
  title            String
  targetEntityType String?
  targetEntityId   String?
  content          Json

  createdAt DateTime @default(now())
}

enum SavedEntityType {
  STORE
  PRODUCT
  AD
  COMPETITOR
  REPORT
}

model SavedItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  entityType SavedEntityType
  folder     String          @default("General")
  tags       Json?

  storeId      String?
  store        Store?      @relation(fields: [storeId], references: [id])
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id])
  adId         String?
  ad           Ad?         @relation(fields: [adId], references: [id])
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id])

  createdAt DateTime @default(now())
}

model Search {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  query String
  type  String?

  createdAt DateTime @default(now())
}

// ============================================================
// DATA PROVIDER TRACKING
// ============================================================

model ApiProviderData {
  id         String @id @default(cuid())
  provider   String
  sourceType String
  entityType String
  entityId   String

  retrievedAt   DateTime
  dataFreshness DataFreshness @default(RECENT)
  confidence    Confidence    @default(MEDIUM)
  methodology   String?       @db.Text
  payload       Json?

  createdAt DateTime @default(now())
}
